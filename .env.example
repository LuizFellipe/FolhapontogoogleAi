# =============================================================================
# CONFIGURAÇÃO DO AMBIENTE - Folha de Ponto
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados MySQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=SUA_SENHA_AQUI
DB_NAME=folhaponto_db

# -----------------------------------------------------------------------------
# Backend Flask
# -----------------------------------------------------------------------------
API_PORT=5000
API_HOST=0.0.0.0

# Habilite apenas para desenvolvimento local (nunca em produção)
FLASK_DEBUG=false

# -----------------------------------------------------------------------------
# Ambiente de Execução (local | docker)
# local: desenvolvimento com start_backend.sh (padrão)
# docker: execução com docker-compose
# Controla automaticamente o proxy do Vite para o backend correto
# -----------------------------------------------------------------------------
VITE_ENVIRONMENT=local

# -----------------------------------------------------------------------------
# Frontend (URL pública do backend acessível pelo navegador)
# Deixe VAZIO para desenvolvimento local e acesso LAN.
# O proxy do Vite encaminha /api/* para o Flask automaticamente.
# Preencha apenas se o backend estiver em um host separado.
# -----------------------------------------------------------------------------
VITE_API_URL=

# -----------------------------------------------------------------------------
# Integrações externas (opcionais)
# -----------------------------------------------------------------------------
# Chave da API Gemini AI (para funcionalidades de IA)
GEMINI_API_KEY=

# URL pública da aplicação (para links e callbacks)
APP_URL=

# -----------------------------------------------------------------------------
# Login básico (credenciais embutidas no frontend — apenas para uso interno)
# Altere antes de expor o sistema em rede pública
# -----------------------------------------------------------------------------
VITE_APP_USERNAME=admin
VITE_APP_PASSWORD=senha123
