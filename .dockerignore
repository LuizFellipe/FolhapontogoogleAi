# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/

# Environment files (keep .env.example)
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Temporary folders
tmp/
temp/

# Database dumps
*.sql
dump.sql
backup.sql

# Python cache (for backend)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Docker files (exclude from build context)
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts
start_backend.sh
*.sh

# Config files that shouldn't be in container
nginx.conf
vite.config.ts
tsconfig.json
tailwind.config.js
.eslintrc*
.prettierrc*
